+from pathlib import Path
+
+p = Path('README.md')
+if not p.exists():
+    raise SystemExit('README.md not found')
+
+s = p.read_text()
+
+# Update toolchain description: Nuclei is now integrated, not future-only.
+s = s.replace(
+    '* **Passive Discovery:** `amass` (**Optional per target**) - OWASP Amass passive enumeration with timeout support * **Future Integration:** `ffuf`, `nuclei` (Ready in Dockerfile)',
+    '* **Passive Discovery:** `amass` (**Optional per target**) - OWASP Amass passive enumeration with timeout support * **Vulnerability Scanning:** `nuclei` (**Optional per target**) - profile-aware template scanning after Probing, with findings ingestion and per-user custom templates. * **Future Integration:** `ffuf`'
+)
+s = s.replace(
+    '* **Deep Scan:** `amass` (Integrated via Docker) * **Future Integration:** `ffuf`, `nuclei` (Ready in Dockerfile)',
+    '* **Deep Scan:** `amass` (Integrated via Docker) * **Vulnerability Scanning:** `nuclei` (**Optional per target**) - profile-aware template scanning after Probing, with findings ingestion and per-user custom templates. * **Future Integration:** `ffuf`'
+)
+
+phase_block = '''
+### ✅ Phase 6: Nuclei Security Engine / v3.3.0 (COMPLETED)
+**Goal:** Add template-based vulnerability scanning while keeping execution safe, tenant-scoped, and human-approved.
+
+* [x] **Nuclei Runner:** Executes Nuclei after Probing when `use_nuclei=true`.
+* [x] **Findings Integration:** Ingests Nuclei JSONL output into Hunt findings with stable fingerprints and deduplication.
+* [x] **Scan Profiles:** Supports `safe`, `fast`, `balanced`, `cves-light`, `full`, and `custom` profiles.
+* [x] **Profile-Aware Template Selection:** Custom template placements control which profiles execute each template.
+* [x] **Custom Template Management:** Users can create, validate, edit, delete, and place custom Nuclei templates from the UI.
+* [x] **Database-Backed Templates:** Custom templates are stored in PostgreSQL with per-user ownership and validation metadata.
+* [x] **Runtime Template Cache:** Templates are materialized to a filesystem cache only when Nuclei needs file-based execution.
+* [x] **Per-User Isolation:** Each user sees and runs only their own custom Nuclei templates.
+* [x] **AI Draft Foundation:** Disabled by default, draft-only, and requires human review before saving or execution.
+* [x] **AI-Ready Strategy Foundation:** Provides a target-aware strategy endpoint for future human-approved agent workflows.
+'''
+
+if '### ✅ Phase 6: Nuclei Security Engine / v3.3.0 (COMPLETED)' not in s:
+    marker = '--- ## Quick Start'
+    if marker in s:
+        s = s.replace(marker, phase_block + ' ' + marker, 1)
+    else:
+        marker = '## Quick Start'
+        if marker not in s:
+            raise SystemExit('Quick Start marker not found')
+        s = s.replace(marker, phase_block + '\n' + marker, 1)
+
+# Add usage documentation for Nuclei target settings and template management.
+usage_block = '''
+### Nuclei Security Engine
+Nuclei can be enabled per target from the Create/Edit Target modal.
+
+Target-level options:
+- **Use Nuclei**: Enables the security scan stage after Probing.
+- **Nuclei Profile**: Controls template scope and aggressiveness:
+  - `safe` - conservative checks for medium/high/critical issues and non-intrusive templates.
+  - `fast` - quick exposure/panel/default-login checks.
+  - `balanced` - broader misconfiguration and exposure coverage.
+  - `cves-light` - CVE-focused checks with a lighter scope.
+  - `full` - broadest built-in and custom template coverage.
+  - `custom` - custom-template-oriented execution.
+
+Nuclei findings are stored in the normal Findings view with `source_tool = nuclei` and `category = nuclei`.
+
+### Custom Nuclei Templates
+Users can manage custom templates from **Nuclei Templates** in the dashboard.
+
+Template workflow:
+1. Create or paste a Nuclei YAML template.
+2. Select a placement group.
+3. Validate the template through the backend.
+4. Save it to the database.
+5. Run a target with a Nuclei profile that includes that placement.
+
+Placement behavior:
+- `root`, `shared`, `safe` - available to all profiles.
+- `fast`, `exposure` - available to `fast`, `balanced`, `full`, and `custom`.
+- `balanced`, `misconfig` - available to `balanced`, `full`, and `custom`.
+- `cves`, `cves-light` - available to `cves-light`, `full`, and `custom`.
+- `full`, `custom` - available to `full` and `custom` only.
+
+Storage model:
+- PostgreSQL is the source of truth for custom templates.
+- Templates are scoped per user.
+- The filesystem under `NUCLEI_CUSTOM_TEMPLATES_DIR` is only a runtime cache used to feed files to the Nuclei CLI.
+- Cache entries are regenerated from the database during scan execution.
+
+### AI Template Drafts and Strategy
+Hunt includes an AI-ready foundation for future template assistance, but it is safe by default.
+
+- `NUCLEI_ALLOW_AI_TEMPLATES=false` by default.
+- Draft generation is disabled unless explicitly enabled.
+- Generated templates are draft-only.
+- Templates are not saved automatically.
+- Templates are not executed automatically.
+- Human approval is required before a draft becomes a saved custom template.
+
+The strategy endpoint can analyze a target's context and recommend profiles, tags, placements, and possible draft inputs for future agent workflows.
+'''
+
+if '### Nuclei Security Engine' not in s:
+    marker = '### Wordlists (Puredns)'
+    if marker not in s:
+        marker = '### Subfinder Provider API Keys (Per-User)'
+    if marker not in s:
+        raise SystemExit('Usage insertion marker not found')
+    s = s.replace(marker, usage_block + '\n' + marker, 1)
+
+# Update API endpoints section.
+api_block = '''
+### Nuclei Templates
+* `GET /api/nuclei/templates` - List current user's custom Nuclei templates.
+* `GET /api/nuclei/templates/:id` - Read a custom template by database ID.
+* `POST /api/nuclei/templates` - Create or update a custom template.
+* `POST /api/nuclei/templates/validate` - Validate a template without saving it.
+* `DELETE /api/nuclei/templates/:id` - Delete a custom template owned by the current user.
+
+### Nuclei AI Drafts / Strategy
+* `GET /api/nuclei/template-drafts/status` - Return whether AI template drafts are enabled.
+* `POST /api/nuclei/template-drafts` - Generate a draft-only template when explicitly enabled.
+* `GET /api/nuclei/template-drafts/targets/:id/strategy` - Return target-aware template/profile recommendations for future agent workflows.
+'''
+
+if '### Nuclei Templates' not in s:
+    marker = '### Dashboard * `GET /api/dashboard/stats`'
+    if marker in s:
+        s = s.replace(marker, api_block + ' ' + marker, 1)
+    else:
+        marker = '### Dashboard'
+        if marker not in s:
+            raise SystemExit('API insertion marker not found')
+        s = s.replace(marker, api_block + '\n' + marker, 1)
+
+# Update export/import example to include nuclei fields if present.
+s = s.replace(
+    '"use_puredns": false, "puredns_wordlists": [], "assets": [...], "urls": [...]',
+    '"use_puredns": false, "use_nuclei": true, "nuclei_profile": "fast", "puredns_wordlists": [], "assets": [...], "urls": [...]'
+)
+
+# Replace old Next Steps vulnerability scanning text if it still says Nuclei is next.
+old_next = '## Next Steps (Phase 6) We are now transitioning to **Vulnerability Scanning**. **Phase 6: Vulnerability Scanning (Backend)** * Integrate **Nuclei** for template-based scanning. * Implement **Smart Filtering** (e.g., run WordPress templates only on WordPress sites). * Immediate Telegram alerts for **Critical/High** vulnerabilities.'
+new_next = '## Next Steps (v3.4.0) We are now transitioning to **Takeover Detection, JS Intelligence, richer evidence, and better Findings UX**. Planned work includes takeover checks, JavaScript intelligence, `evidence_json`, and improved evidence rendering in the Findings UI.'
+s = s.replace(old_next, new_next)
+
+# Add environment variables for Nuclei/AI if Environment Configuration exists.
+env_block = '''
+Nuclei runtime and AI-template controls:
+```env
+NUCLEI_TEMPLATES_DIR=/root/nuclei-templates
+NUCLEI_CUSTOM_TEMPLATES_DIR=/data/nuclei/custom
+NUCLEI_ALLOW_AI_TEMPLATES=false
+```
+`NUCLEI_CUSTOM_TEMPLATES_DIR` is a runtime cache path. Custom templates are stored in PostgreSQL and materialized to this directory when scans run. Keep `NUCLEI_ALLOW_AI_TEMPLATES=false` unless you intentionally enable draft-only AI template generation.
+'''
+
+if 'NUCLEI_ALLOW_AI_TEMPLATES' not in s:
+    marker = 'Large-target runtime tuning:'
+    if marker in s:
+        s = s.replace(marker, env_block + '\n' + marker, 1)
+    else:
+        marker = 'Optional integrations:'
+        if marker in s:
+            # place after optional integrations paragraph if exact marker exists
+            s = s.replace(marker, env_block + '\n' + marker, 1)
+
+# Add release summary near end if not present.
+release_block = '''
+---
+## v3.3.0 Release Summary
+
+Version `v3.3.0` completes the Nuclei Security Engine milestone:
+
+- Nuclei execution after Probing.
+- Findings ingestion from Nuclei JSONL output.
+- Canonical scan profiles and profile-aware custom template placement.
+- Database-backed, per-user custom template management.
+- Runtime filesystem cache for Nuclei CLI compatibility.
+- Template validation from the UI/API.
+- AI template draft foundation disabled by default.
+- AI-ready target strategy foundation for future human-approved agent workflows.
+'''
+
+if '## v3.3.0 Release Summary' not in s:
+    marker = '## Contributing'
+    if marker in s:
+        s = s.replace(marker, release_block + '\n' + marker, 1)
+    else:
+        s += '\n' + release_block
+
+p.write_text(s)
+print('README.md updated for v3.3.0 Nuclei Security Engine release')
