# =========================================================
# Hunt Engine - Environment Configuration Example
# =========================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Edit .env with your specific values for your environment (Dev, Stage, Prod)
# 3. Run: docker compose up -d
# ---------------------------------------------------------

# --------------------------
# Project & Network
# --------------------------
COMPOSE_PROJECT_NAME=hunt-dev
DOMAIN_NAME=localhost
SERVER_IP=127.0.0.1

# --------------------------
# Database (PostgreSQL)
# --------------------------
DB_USER=hunter
DB_PASSWORD=change_me_to_a_strong_database_password
DB_NAME=huntdb

# --------------------------
# Cache (Redis)
# --------------------------
REDIS_PORT=6379

# --------------------------
# Security (JWT)
# --------------------------
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_64_hex_secret_minimum_length

# --------------------------
# Backend Performance & Tuning
# --------------------------
# Maximum accepted HTTP request body size in MB (Transport Ceiling)
HUNT_MAX_REQUEST_BODY_MB=5120

# Worker Batching & Concurrency
PROBE_BATCH_SIZE=1000
DNSX_BATCH_SIZE=2000
DNSX_THREADS=30
AMASS_TIMEOUT_SECONDS=900
TRUSTED_RESOLVERS=1.1.1.1,8.8.8.8,1.0.0.1,8.8.4.4

# --------------------------
# Nuclei Security Engine
# --------------------------
NUCLEI_CUSTOM_TEMPLATES_DIR=/data/nuclei/custom
NUCLEI_ALLOW_AI_TEMPLATES=false
HUNT_NUCLEI_TIMEOUT=10m

# --------------------------
# Optional Integrations
# --------------------------
VIRUSTOTAL_API_KEY=

# --------------------------
# Advanced / Legacy Controls
# --------------------------
ALTERX_MAX_RESULTS=0
