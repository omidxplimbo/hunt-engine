# Hunt Engine environment example
# Copy this file to .env and replace every placeholder before running Docker Compose.

# Public deployment settings
DOMAIN_NAME=example.com
SSL_EMAIL=admin@example.com
SERVER_IP=127.0.0.1

# Database
DB_USER=hunter
DB_PASSWORD=change_this_database_password
DB_NAME=huntdb

# Required application secret
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_random_characters

# Optional notifications / third-party APIs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
VIRUSTOTAL_API_KEY=

# Worker tuning
PROBE_BATCH_SIZE=1000
DNSX_BATCH_SIZE=5000
ALTERX_MAX_RESULTS=0
TRUSTED_RESOLVERS=1.1.1.1,8.8.8.8,1.0.0.1,8.8.4.4

DNSX_BATCH_SIZE=2000
DNSX_THREADS=30
AMASS_TIMEOUT_SECONDS=900
