# Hunt Engine environment configuration
# Copy this file to .env and edit values before running docker compose.

# Domain / reverse proxy
DOMAIN_NAME=localhost
SSL_EMAIL=admin@example.com
SERVER_IP=127.0.0.1

# Database
DB_USER=hunter
DB_PASSWORD=change_me_to_a_strong_database_password
DB_NAME=huntdb

# Security
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_64_hex_secret

# Maximum accepted HTTP request body size in MB for large uploads.
# This is a transport ceiling; per-user wordlist quotas are still enforced by the backend.
# 5120 = 5GB.
HUNT_MAX_REQUEST_BODY_MB=5120


# Redis
REDIS_PORT=6379

# Worker tuning
PROBE_BATCH_SIZE=1000
DNSX_BATCH_SIZE=2000
DNSX_THREADS=30
AMASS_TIMEOUT_SECONDS=900
TRUSTED_RESOLVERS=1.1.1.1,8.8.8.8,1.0.0.1,8.8.4.4

# Optional integrations
VIRUSTOTAL_API_KEY=

# Optional legacy/performance controls
# 0 means unlimited where supported.
ALTERX_MAX_RESULTS=0

# Nuclei Security Engine
NUCLEI_TIMEOUT_SECONDS=1800
NUCLEI_RATE_LIMIT=50
NUCLEI_CONCURRENCY=10
NUCLEI_BULK_SIZE=25
NUCLEI_TEMPLATES_DIR=/root/nuclei-templates
NUCLEI_CUSTOM_TEMPLATES_DIR=/data/nuclei/custom
NUCLEI_DEFAULT_PROFILE=safe
NUCLEI_ALLOW_AI_TEMPLATES=false
HUNT_NUCLEI_TIMEOUT=10m

# Persistent storage path for account custom PureDNS wordlists.
# This host directory is mounted into backend as /data/wordlists.
HUNT_WORDLISTS_DIR=./hunt-wordlists
